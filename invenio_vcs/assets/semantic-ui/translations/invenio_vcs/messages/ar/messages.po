msgid ""
"Repository sync started in the background. Please reload the page in about a"
" minute."
msgstr " بدأت مزامنة المستودع. يُرجى إعادة تحميل الصفحة بعد حوالي دقيقة."

msgid ""
"The repository sync failed (status {{status}}). Please try again later."
msgstr ""
" فشلت مزامنة المستودع (الحالة: {{status}}). يُرجى المحاولة مرة أخرى لاحقًا."

msgid ""
"This action seems to take some time, refresh the page after several minutes "
"to inspect the synchronisation."
msgstr ""
" يبدو أن هذه العملية تستغرق بعض الوقت. يُرجى تحديث الصفحة بعد بضع دقائق "
"للتحقق من حالة المزامنة."

msgid "There has been a problem: {{error}}"
msgstr " حدثت مشكلة: {{error}}"

msgid "Repository enabled successfully. Please reload the page."
msgstr " تم تفعيل المستودع بنجاح. يُرجى إعادة تحميل الصفحة."

msgid ""
"Failed to update repository (status {{status}}). Please try again later."
msgstr ""
" تعذّر تحديث المستودع (رمز الحالة: {{status}}). يُرجى إعادة المحاولة لاحقًا."
