msgid ""
"Repository sync started in the background. Please reload the page in about a"
" minute."
msgstr ""
"La sincronización del repositorio se ha iniciado en segundo plano. Vuelva a "
"cargar la página en aproximadamente un minuto."

msgid ""
"The repository sync failed (status {{status}}). Please try again later."
msgstr ""
"La sincronización del repositorio falló (estado {{status}}). Inténtelo de "
"nuevo más tarde."

msgid ""
"This action seems to take some time, refresh the page after several minutes "
"to inspect the synchronisation."
msgstr ""
"Esta acción parece tardar un tiempo; actualice la página después de unos "
"minutos para comprobar la sincronización."

msgid "There has been a problem: {{error}}"
msgstr "Ha habido un problema: {{error}}"

msgid "Repository enabled successfully. Please reload the page."
msgstr "Repositorio habilitado correctamente. Por favor, recargue la página."

msgid ""
"Failed to update repository (status {{status}}). Please try again later."
msgstr ""
"No se pudo actualizar el repositorio (estado {{status}}). Inténtelo de nuevo"
" más tarde."
