msgid ""
"Repository sync started in the background. Please reload the page in about a"
" minute."
msgstr ""
"Synchronizace repozitáře byla spuštěna na pozadí. Obnovte prosím stránku po "
"pár minutách."

msgid ""
"The repository sync failed (status {{status}}). Please try again later."
msgstr ""
"Synchronizace repozitáře selhala (stav {{status}}). Zkuste to prosím znovu "
"později."

msgid ""
"This action seems to take some time, refresh the page after several minutes "
"to inspect the synchronisation."
msgstr ""
"Zdá se, že tato akce chvíli potrvá; po několika minutách obnovte stránku a "
"zkontrolujte synchronizaci."

msgid "There has been a problem: {{error}}"
msgstr "Došlo k problému: {{error}}"

msgid "Repository enabled successfully. Please reload the page."
msgstr "Repozitář byl úspěšně povolen. Načtěte prosím stránku znovu."

msgid ""
"Failed to update repository (status {{status}}). Please try again later."
msgstr ""
"Nepodařilo se aktualizovat repozitář (stav {{status}}). Zkuste to prosím "
"znovu později."
